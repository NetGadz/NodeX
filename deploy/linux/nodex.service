[Unit]
Description=NodeX Kademlia DHT Bootstrap Node
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/NodeX
ExecStart=/root/NodeX/target/release/nodex-cli --port 8443 --ip 0.0.0.0 --name GenesisBootstrap --daemon --no-bootstrap --state-file /root/NodeX/node_state.json
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=20
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
